{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Media": {
    "Provider": "Local",
    "RootPath": "media",
    "PublicPrefix": "/media",
    "PublicBaseUrl": "",
    "MaxBytes": 8388608,
    "S3": {
      "Endpoint": "",
      "Bucket": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  }
}
