# Template only: .NET does not load this file automatically.
# Set these variables in your host's environment/secret manager.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Catalog=Host=<db-host>;Port=<db-port>;Database=<db-name>;Username=<db-user>;Password=<secret>;SSL Mode=VerifyFull
Admin__Email=<owner-email>
Admin__PasswordHash=<sha256-password-hash>
Admin__TokenSigningKey=<long-random-server-secret>
Cors__AllowedOrigins__0=https://<storefront-host>
Cors__AllowedOrigins__1=https://<admin-host>
Media__Provider=S3
Media__PublicBaseUrl=https://<api-host>
Media__S3__Endpoint=https://<s3-endpoint>
Media__S3__Bucket=<bucket-name>
Media__S3__Region=<provider-region>
Media__S3__AccessKey=<server-secret>
Media__S3__SecretKey=<server-secret>
Media__S3__ForcePathStyle=true
Payments__SandboxEnabled=false
# Leave these empty until the Zibal merchant is issued. Staging may use `zibal` as the merchant.
Payments__Zibal__Merchant=
# Public HTTPS callback handled by the API; this exact domain must be registered in Zibal.
Payments__Zibal__CallbackUrl=https://api.example.com/api/v1/payments/zibal/callback
# Public checkout route to which the API returns the customer after server-side verification.
Payments__Zibal__ReturnUrl=https://store.example.com/checkout
