# Template only. The subdomains below are planned; provision them after choosing the host.
# Copy outside the repository, replace every placeholder, and load into the host secret manager.
# Read-only check: node --env-file=/private/release.env scripts/release-preflight.mjs
# After gateway setup add --payments. Never commit the completed file.
MAZEDUNEH_RELEASE_BUILD=true
NEXT_PUBLIC_MAZEDUNEH_DEMO_MODE=false
NEXT_PUBLIC_MAZEDUNEH_API_URL=https://api.mazeduneh.ir
NEXT_PUBLIC_SITE_URL=https://mazeduneh.ir
NEXT_PUBLIC_MAZEDUNEH_ADMIN_URL=https://admin.mazeduneh.ir
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Catalog="Host=<db-host>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<secret>;SSL Mode=VerifyFull"
Admin__Email=<owner-email>
Admin__PasswordHash=<sha256-hash-of-new-strong-password>
Admin__TokenSigningKey=<at-least-32-random-characters>
Admin__Mfa__SensitiveActionsRequired=true
Admin__Mfa__TotpSecret=<random-base32-totp-seed>
Cors__AllowedOrigins__0=https://mazeduneh.ir
Cors__AllowedOrigins__1=https://admin.mazeduneh.ir
# Local persistent volume option. Include this directory and PostgreSQL in backups.
Media__Provider=Local
Media__RootPath=/var/lib/mazeduneh/media
Media__PublicBaseUrl=https://api.mazeduneh.ir
# S3 alternative: set Media__Provider=S3 and provide Endpoint/Bucket/Region/AccessKey/SecretKey.
Payments__SandboxEnabled=false
Payments__Zibal__Merchant=
Payments__Zibal__CallbackUrl=https://api.mazeduneh.ir/api/v1/payments/zibal/callback
Payments__Zibal__ReturnUrl=https://mazeduneh.ir/checkout
