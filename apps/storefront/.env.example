# Public API origin used by the browser for catalog and order submission.
# Do not put secrets here. When this is set, the API-backed storefront is used
# automatically unless NEXT_PUBLIC_MAZEDUNEH_DEMO_MODE=true.
NEXT_PUBLIC_MAZEDUNEH_API_URL=https://api.example.com

# Keep the safe storefront preview explicitly enabled until the API is public.
NEXT_PUBLIC_MAZEDUNEH_DEMO_MODE=true
